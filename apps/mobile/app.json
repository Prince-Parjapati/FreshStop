{
  "expo": {
    "name": "Mandi Khata",
    "slug": "mandi-khata",
    "version": "1.0.0",
    "scheme": "mandimart",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-contacts",
        {
          "contactsPermission": "Mandi Khata reads a contact only when you tap 'Pick from contacts' to fill a party's name and phone. Contacts are never uploaded."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#16A34A",
          "imageWidth": 200
        }
      ],
      "@sentry/react-native"
    ],
    "android": {
      "package": "com.mandimart.pro",
      "versionCode": 1,
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#16A34A",
        "monochromeImage": "./assets/monochrome-icon.png"
      },
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "experiments": {
      "typedRoutes": false
    },
    "icon": "./assets/icon.png",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a3e20aa3-ab3d-49a2-970e-ea8014e995c1"
      }
    },
    "owner": "veg-mart-organization"
  }
}
